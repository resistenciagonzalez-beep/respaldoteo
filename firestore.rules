rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identifies trusted administrators by email token or verified admin profile in database
    function isAdmin() {
      return (
        (isSignedIn() && request.auth.token.email != null &&
         request.auth.token.email in [
           'resistenciagonzalez@gmail.com',
           'genesis.vargas0619@gmail.com',
           'admin@bolillerobingo.com'
         ]) ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users collection: User accounts, roles, and status
    match /users/{userId} {
      // Allow read so operators and admins can authenticate, check credentials, and synchronize profiles
      allow read: if true;

      // Create and Update: Allow valid user documents
      allow create, update: if isValidId(userId);

      // Delete: Strictly reserved for Administrators
      allow delete: if isAdmin() || (
        isSignedIn() && request.auth.token.email in [
          'resistenciagonzalez@gmail.com',
          'genesis.vargas0619@gmail.com',
          'admin@bolillerobingo.com'
        ]
      );
    }

    // 2. Saved Games collection: Historical bingo games
    match /saved_games/{gameId} {
      // Read access for archived review, game verification, and sequence shortcuts
      allow read: if true;

      // Create and Update: All operators and admins can save or update game snapshots
      allow create, update: if isValidId(gameId) &&
        request.resource.data.round is number &&
        request.resource.data.operatorName is string;

      // Delete: Strictly reserved for Administrators
      allow delete: if isAdmin();
    }

    // 3. Operator Shifts collection: Shift turnos
    match /operator_shifts/{shiftId} {
      allow read: if true;

      // Create and Update: Operators and admins can record and update shifts
      allow create, update: if isValidId(shiftId) &&
        request.resource.data.operatorName is string;

      // Delete: Strictly reserved for Administrators
      allow delete: if isAdmin();
    }

    // 4. Activity Logs collection: Audit trail of operator actions
    match /activity_logs/{logId} {
      // Operators and admins can inspect activity log
      allow read: if true;

      // Active operators and admins can record activity entries
      allow create: if isValidId(logId) &&
        request.resource.data.action is string &&
        request.resource.data.actionType is string;

      // Audit logs are tamper-proof and immutable
      allow update, delete: if false;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
