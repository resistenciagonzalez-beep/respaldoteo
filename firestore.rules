rules_version = '2';

// Reglas de seguridad de Bolillero Bingo
// - Solo usuarios con sesión de Firebase Authentication pueden leer o escribir.
// - Las operadoras solo ven y guardan SUS partidas y turnos (campo ownerUid).
// - Los administradores ven todo.
// - Solo los administradores pueden borrar partidas, carpetas o usuarios, y cambiar rangos.
// - Las cuentas nuevas quedan pendientes hasta que un administrador las aprueba.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActive() {
      return hasProfile() && myProfile().get('status', 'active') == 'active';
    }

    function isAdmin() {
      return isActive() && myProfile().get('role', 'operator') == 'admin';
    }

    // Correos que pueden darse rango de administrador a si mismos, SOLO con el correo verificado
    function isListedAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'resistenciagonzalez@gmail.com',
          'genesis.vargas0619@gmail.com',
          'bingoteteoo@gmail.com'
        ];
    }

    // Correos de administración (para que su cuenta nueva quede activa de una vez)
    function isAdminListEmail() {
      return isSignedIn() && request.auth.token.email in [
        'resistenciagonzalez@gmail.com',
        'genesis.vargas0619@gmail.com',
        'bingoteteoo@gmail.com'
      ];
    }

    // Cuenta antigua (anterior a Firebase Authentication) que se está migrando: ya estaba aprobada
    function isLegacyMigration() {
      return request.resource.data.get('legacyIds', []) is list
        && request.resource.data.get('legacyIds', []).size() > 0
        && exists(userPath(request.resource.data.legacyIds[0]))
        && get(userPath(request.resource.data.legacyIds[0])).data.get('email', '') == request.auth.token.email;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 200;
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function noNewPasswordFields() {
      return (!('passwordHash' in request.resource.data) || unchanged('passwordHash'))
        && (!('password' in request.resource.data) || unchanged('password'));
    }

    // 1. Usuarios
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || resource.data.email == request.auth.token.email
      );
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.email == request.auth.token.email);

      // Cuenta nueva: queda 'pending' hasta que un administrador la apruebe
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.get('status', '') == 'pending'
            || (request.resource.data.get('status', '') == 'active' && (isAdminListEmail() || isLegacyMigration())))
        && !('password' in request.resource.data)
        && !('passwordHash' in request.resource.data)
        && (request.resource.data.get('role', 'operator') == 'operator'
            || (request.resource.data.role == 'admin' && isListedAdminEmail()));

      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && unchanged('email')
            && unchanged('status')
            && ((unchanged('role') && unchanged('assignedMode'))
                || (request.resource.data.role == 'admin' && isListedAdminEmail()))
            && noNewPasswordFields());

      allow delete: if isAdmin();
    }

    // 2. Partidas guardadas
    match /saved_games/{gameId} {
      allow get, list: if isAdmin()
        || (isActive() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(gameId)
        && request.resource.data.round is number
        && request.resource.data.operatorName is string
        && (isAdmin() || (isActive() && request.resource.data.ownerUid == request.auth.uid));

      allow update: if isAdmin()
        || (isActive()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid);

      allow delete: if isAdmin();
    }

    // 3. Registro de partidas borradas (para que todos los dispositivos se actualicen sin descargar todo)
    match /deleted_games/{gameId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // 4. Avisos de sincronizacion por usuario
    match /sync_hints/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // 5. Turnos de operadoras
    match /operator_shifts/{shiftId} {
      allow get, list: if isAdmin()
        || (isActive() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(shiftId)
        && request.resource.data.operatorName is string
        && (isAdmin() || (isActive() && request.resource.data.ownerUid == request.auth.uid));

      allow update: if isAdmin()
        || (isActive()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid);

      allow delete: if isAdmin();
    }

    // 6. Historial de actividad (no se puede modificar ni borrar)
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && isValidId(logId)
        && request.resource.data.operatorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.actionType is string;
      allow update, delete: if false;
    }

    // Todo lo demas esta bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
